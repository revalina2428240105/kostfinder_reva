{
  "name": "kostfinder",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace backend run dev",
    "dev:web": "npm --workspace frontend run dev",
    "start:api": "npm --workspace backend run start",
    "db:deploy": "npm --workspace backend run db:deploy",
    "db:generate": "npm --workspace backend run db:generate",
    "db:migrate": "npm --workspace backend run db:migrate",
    "db:seed": "node backend/prisma/seed.js",
    "owner:create": "npm --workspace backend run owner:create",
    "test:smoke": "npm --workspace backend run test:smoke",
    "build": "npm --workspace frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@prisma/client@6.12.0": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true
  }
}
