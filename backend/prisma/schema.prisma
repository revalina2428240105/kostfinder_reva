generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  TENANT
}
enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  ARCHIVED
}
enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}
enum InvoiceStatus {
  UNPAID
  PENDING_REVIEW
  PAID
  REJECTED
  OVERDUE
}
enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(TENANT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  properties   Property[]
  bookings     Booking[]
  invoices     Invoice[]
  notifications Notification[]
  audits       AuditLog[]
}

model Property {
  id           String   @id @default(cuid())
  ownerId      String
  name         String
  description  String   @db.Text
  address      String
  city         String
  district     String
  contactPhone String?
  rules        String?  @db.Text
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  rooms        Room[]
  facilities   PropertyFacility[]
  @@index([city, district, published])
  @@index([ownerId])
}

model Room {
  id          String @id @default(cuid())
  propertyId  String
  name        String
  type        String
  description String @db.Text
  price       Decimal @db.Decimal(12, 2)
  period      String @default("MONTHLY")
  capacity    Int @default(1)
  status      RoomStatus @default(AVAILABLE)
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  facilities  RoomFacility[]
  bookings    Booking[]
  @@index([propertyId, status])
  @@index([price])
}

model Facility {
  id         String @id @default(cuid())
  name       String @unique
  icon       String?
  rooms      RoomFacility[]
  properties PropertyFacility[]
}

model RoomFacility {
  roomId String
  facilityId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  @@id([roomId, facilityId])
}

model PropertyFacility {
  propertyId String
  facilityId String
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  @@id([propertyId, facilityId])
}

model Booking {
  id String @id @default(cuid())
  userId String
  roomId String
  checkIn DateTime
  duration Int
  total Decimal @db.Decimal(12, 2)
  status BookingStatus @default(PENDING)
  decisionNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)
  histories BookingStatusHistory[]
  invoices Invoice[]
  @@index([userId, status])
  @@index([roomId, checkIn])
}

model BookingStatusHistory {
  id String @id @default(cuid())
  bookingId String
  actorId String
  status BookingStatus
  note String?
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId, createdAt])
}

model Invoice {
  id String @id @default(cuid())
  number String @unique
  bookingId String
  tenantId String
  amount Decimal @db.Decimal(12, 2)
  periodStart DateTime
  periodEnd DateTime
  issuedAt DateTime @default(now())
  dueAt DateTime
  status InvoiceStatus @default(UNPAID)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  tenant User @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payments Payment[]
  @@index([tenantId, status])
  @@index([dueAt, status])
}

model Payment {
  id String @id @default(cuid())
  invoiceId String
  amount Decimal @db.Decimal(12, 2)
  method String @default("BANK_TRANSFER")
  proofUrl String?
  status PaymentStatus @default(PENDING)
  reviewNote String?
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  histories PaymentStatusHistory[]
  @@index([invoiceId, status])
}

model PaymentStatusHistory {
  id String @id @default(cuid())
  paymentId String
  actorId String
  status PaymentStatus
  note String?
  createdAt DateTime @default(now())
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@index([paymentId, createdAt])
}

model Notification {
  id String @id @default(cuid())
  userId String
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  entity String
  entityId String?
  details Json?
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([actorId, createdAt])
}
